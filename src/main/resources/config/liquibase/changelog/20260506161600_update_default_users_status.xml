<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260506162000-1" author="Phuc Cung">
        <!-- Update trạng thái thành ACTIVE cho các user mặc định -->
        <update tableName="jhi_user">
            <column name="user_status" value="ACTIVE"/>
            <where>login IN ('admin', 'user', 'system', 'anonymoususer')</where>
        </update>
    </changeSet>

</databaseChangeLog>
